# 1. Ignore all folders and files at the root level by default
/*

# 2. Allow Git to track .gitignore itself
!/.gitignore

# 3. Whitelist the specific project subfolders you want to track
!/CS Amp with Ideal Current Source Load/


# 4. Ignore Obsidian settings folders across all tracked projects
.obsidian/
**/obsidian/
